<UserControl x:Class="WPF_MVVM_Demo.Views.OneWayBindingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="Transparent">

    <UserControl.Resources>
        <Style TargetType="Border" x:Key="DemoInnerBorder">
            <Setter Property="Background" Value="{StaticResource PanelLightBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" Opacity="0.3" ShadowDepth="3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock" x:Key="DescriptionStyle">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Opacity" Value="0.8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="ValueDisplayStyle">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        </Style>

        <Style x:Key="DirectionArrowStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="15,5"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style x:Key="OneWayButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  Background="Transparent">
        <StackPanel Margin="5">
            <TextBlock Text="{Tr 'OneWay.Title', DefaultText='OneWay Bindings'}" 
                       Style="{StaticResource SectionHeaderStyle}"
                       Foreground="{StaticResource AccentBrush}"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- OneWay от источника к цели -->
                <Border Grid.Column="0" Style="{StaticResource DemoInnerBorder}">
                    <StackPanel>
                        <TextBlock Text="OneWay (ViewModel → UI)" 
                                   Style="{StaticResource SubHeaderStyle}"
                                   Foreground="{StaticResource SuccessBrush}"/>

                        <Border Style="{StaticResource DirectionArrowStyle}"
                                Background="{StaticResource SuccessBrush}">
                            <TextBlock Text="{Tr 'OneWay.Flow.SourceToTarget', DefaultText='Data flow: source -> target'}" 
                                      Foreground="White"
                                      FontWeight="Bold"
                                      HorizontalAlignment="Center"/>
                        </Border>

                        <Border Background="{StaticResource PanelBrush}"
                                Padding="20"
                                CornerRadius="5"
                                Margin="0,10">
                            <StackPanel>
                                <TextBlock Text="{Tr 'OneWay.Counter.Label', DefaultText='Counter in ViewModel:'}" 
                                          Foreground="{StaticResource TextBrush}"
                                          FontWeight="Bold"
                                          HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Counter}" 
                                           Style="{StaticResource ValueDisplayStyle}"
                                           Foreground="{StaticResource SuccessBrush}"
                                           FontSize="36"
                                           HorizontalAlignment="Center"
                                           Margin="10"/>
                            </StackPanel>
                        </Border>

                        <Button Content="{Tr 'OneWay.Counter.Increase', DefaultText='Increase counter'}" 
                                Command="{Binding IncrementCounterCommand}"
                                Style="{StaticResource OneWayButtonStyle}"
                                Background="{StaticResource SuccessBrush}"
                                Margin="0,5" 
                                Padding="15,8"/>

                        <Border Background="{StaticResource PanelBrush}"
                                Padding="10"
                                CornerRadius="5"
                                Margin="0,10">
                            <StackPanel>
                                <TextBlock Text="{Tr 'OneWay.ReadOnly.Label', DefaultText='Read-only text:'}" 
                                          Foreground="{StaticResource TextBrush}"
                                          FontWeight="Bold"/>
                                <TextBox Text="{Binding ReadOnlyText, Mode=OneWay}" 
                                         IsReadOnly="True" 
                                         Background="{StaticResource PanelLightBrush}"
                                         Foreground="{StaticResource SuccessBrush}"
                                         Margin="0,5"
                                         Padding="8"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PanelBrush}" 
                                Padding="10" 
                                Margin="0,5"
                                CornerRadius="5">
                            <TextBlock Text="{Tr 'OneWay.Hint.SourceToTarget', DefaultText='Changes in ViewModel update UI, but not vice versa'}" 
                                      Style="{StaticResource DescriptionStyle}"
                                      Foreground="{StaticResource SuccessBrush}"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- OneWayToSource -->
                <Border Grid.Column="1" Style="{StaticResource DemoInnerBorder}">
                    <StackPanel>
                        <TextBlock Text="OneWayToSource (UI → ViewModel)" 
                                   Style="{StaticResource SubHeaderStyle}"
                                   Foreground="{StaticResource DangerBrush}"/>

                        <Border Style="{StaticResource DirectionArrowStyle}"
                                Background="{StaticResource DangerBrush}">
                            <TextBlock Text="{Tr 'OneWay.Flow.TargetToSource', DefaultText='Data flow: target -> source'}" 
                                      Foreground="White"
                                      FontWeight="Bold"
                                      HorizontalAlignment="Center"/>
                        </Border>

                        <Border Background="{StaticResource PanelBrush}"
                                Padding="15"
                                CornerRadius="5"
                                Margin="0,10">
                            <StackPanel>
                                <TextBlock Text="{Tr 'OneWay.TargetToSource.Enter', DefaultText='Enter text (updates ViewModel):'}" 
                                          Foreground="{StaticResource TextBrush}"
                                          FontWeight="Bold"/>
                                <TextBox Text="{Binding ReadOnlyText, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}" 
                                         Margin="0,5"
                                         Padding="8"
                                         Background="{StaticResource PanelLightBrush}"
                                         Foreground="{StaticResource TextBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PanelBrush}"
                                Padding="15"
                                CornerRadius="5"
                                Margin="0,5">
                            <StackPanel>
                                <TextBlock Text="{Tr 'OneWay.TargetToSource.Current', DefaultText='Current value in ViewModel:'}" 
                                          Foreground="{StaticResource TextBrush}"
                                          FontWeight="Bold"/>
                                <TextBlock Text="{Binding ReadOnlyText}" 
                                           Style="{StaticResource ValueDisplayStyle}"
                                           Foreground="{StaticResource DangerBrush}"
                                           FontSize="20"
                                           HorizontalAlignment="Center"
                                           Margin="5"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PanelBrush}" 
                                Padding="10" 
                                Margin="0,5"
                                CornerRadius="5">
                            <TextBlock Text="{Tr 'OneWay.Hint.TargetToSource', DefaultText='UI changes update ViewModel, but ViewModel changes do not update UI'}" 
                                      Style="{StaticResource DescriptionStyle}"
                                      Foreground="{StaticResource DangerBrush}"
                                      TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Данные Person с OneWay -->
                <Border Grid.Column="0" Style="{StaticResource DemoInnerBorder}">
                    <StackPanel>
                        <TextBlock Text="{Tr 'OneWay.Person.Title', DefaultText='Person data (OneWay)'}" 
                                   Style="{StaticResource SubHeaderStyle}"
                                   Foreground="{StaticResource SuccessBrush}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Tr 'OneWay.Person.FirstName', DefaultText='First name:'}" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="5"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Person.FirstName}" Margin="10,5" Foreground="{StaticResource SuccessBrush}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Tr 'OneWay.Person.LastName', DefaultText='Last name:'}" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="5"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Person.LastName}" Margin="10,5" Foreground="{StaticResource SuccessBrush}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Tr 'OneWay.Person.Age', DefaultText='Age:'}" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="5"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Person.Age}" Margin="10,5" Foreground="{StaticResource SuccessBrush}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{Tr 'OneWay.Person.FullName', DefaultText='Full name:'}" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="5"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Person.FullName}" Margin="10,5" Foreground="{StaticResource AccentLightBrush}" FontWeight="Bold"/>
                        </Grid>

                        <TextBlock Text="{Tr 'OneWay.Person.Hint', DefaultText='* Updates when ViewModel changes'}" 
                                   Style="{StaticResource DescriptionStyle}"
                                   Margin="0,5"/>
                    </StackPanel>
                </Border>

                <!-- Кнопки для изменения Person -->
                <Border Grid.Column="1" Style="{StaticResource DemoInnerBorder}" 
                        Background="{StaticResource PanelBrush}">
                    <StackPanel>
                        <TextBlock Text="{Tr 'OneWay.Controls.Title', DefaultText='Person controls in ViewModel'}" 
                                   Style="{StaticResource SubHeaderStyle}"
                                   Foreground="{StaticResource WarningBrush}"/>

                        <Button Content="{Tr 'OneWay.Controls.ChangeName', DefaultText='Change name to [apos]New Name[apos]'}" 
                                Command="{Binding UpdatePersonCommand}"
                                Style="{StaticResource OneWayButtonStyle}"
                                Background="{StaticResource WarningBrush}"
                                Margin="0,5" 
                                Padding="15,8"/>

                        <Button Content="{Tr 'OneWay.Controls.IncreaseAge', DefaultText='Increase age'}" 
                                Command="{Binding UpdatePersonCommand}"
                                CommandParameter="age"
                                Style="{StaticResource OneWayButtonStyle}"
                                Background="{StaticResource DangerBrush}"
                                Margin="0,5" 
                                Padding="15,8"/>

                        <Border Background="{StaticResource PanelLightBrush}" 
                                Padding="10" 
                                Margin="0,10"
                                CornerRadius="5">
                            <StackPanel>
                                <TextBlock Text="{Tr 'OneWay.Controls.Result', DefaultText='Result:'}" 
                                          FontWeight="Bold"
                                          Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="{Tr 'OneWay.Controls.Result.Left', DefaultText='• Changes appear in the left column'}" 
                                          Style="{StaticResource DescriptionStyle}"/>
                                <TextBlock Text="{Tr 'OneWay.Controls.Result.Auto', DefaultText='• OneWay binding updates UI automatically'}" 
                                          Style="{StaticResource DescriptionStyle}"/>
                                <TextBlock Text="{Tr 'OneWay.Controls.Result.NoDirect', DefaultText='• UI cannot directly change these values'}" 
                                          Style="{StaticResource DescriptionStyle}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Background="{StaticResource PanelBrush}" 
                    Padding="20" 
                    Margin="5,10"
                    CornerRadius="8"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="2">
                <StackPanel>
                    <TextBlock Text="{Tr 'OneWay.Info.Title', DefaultText='One-way bindings description'}" 
                              FontSize="16" 
                              FontWeight="Bold"
                              Foreground="{StaticResource AccentBrush}"
                              Margin="0,0,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="5">
                            <TextBlock Text="✅ OneWay (ViewModel → UI)" 
                                      FontWeight="Bold"
                                      Foreground="{StaticResource SuccessBrush}"/>
                            <TextBlock Text="{Tr 'OneWay.Info.OneWay.Flow', DefaultText='• Data flows from source to target only'}" 
                                      Style="{StaticResource DescriptionStyle}"/>
                            <TextBlock Text="{Tr 'OneWay.Info.OneWay.UpdateUi', DefaultText='• ViewModel changes update UI'}" 
                                      Style="{StaticResource DescriptionStyle}"/>
                            <TextBlock Text="{Tr 'OneWay.Info.OneWay.NoVm', DefaultText='• UI changes do not affect ViewModel'}" 
                                      Style="{StaticResource DescriptionStyle}"/>
                            <TextBlock Text="{Tr 'OneWay.Info.OneWay.Display', DefaultText='• Ideal for displaying data'}" 
                                      Style="{StaticResource DescriptionStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="5">
                            <TextBlock Text="⚠️ OneWayToSource (UI → ViewModel)" 
                                      FontWeight="Bold"
                                      Foreground="{StaticResource DangerBrush}"/>
                            <TextBlock Text="{Tr 'OneWay.Info.OneWayToSource.Flow', DefaultText='• Data flows from target to source'}" 
                                      Style="{StaticResource DescriptionStyle}"/>
                            <TextBlock Text="{Tr 'OneWay.Info.OneWayToSource.UpdateVm', DefaultText='• UI changes update ViewModel'}" 
                                      Style="{StaticResource DescriptionStyle}"/>
                            <TextBlock Text="{Tr 'OneWay.Info.OneWayToSource.NoUi', DefaultText='• ViewModel changes are not shown in UI'}" 
                                      Style="{StaticResource DescriptionStyle}"/>
                            <TextBlock Text="{Tr 'OneWay.Info.OneWayToSource.Collect', DefaultText='• Useful for collecting input'}" 
                                      Style="{StaticResource DescriptionStyle}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>