<UserControl x:Class="WPF_MVVM_Demo.Views.TwoWayBindingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:res="clr-namespace:WPF_MVVM_Demo.Resources"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="Transparent">

    <UserControl.Resources>
        <Style TargetType="Border" x:Key="DemoInnerBorder">
            <Setter Property="Background" Value="{StaticResource PanelLightBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="DescriptionStyle">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Opacity" Value="0.8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="SubHeaderStyle">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="SectionHeaderStyle">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="ValueDisplayStyle">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  Background="Transparent">
        <StackPanel Margin="5">
            <TextBlock Text="{res:LocalizationExtension Key=TwoWayBinding_Title}" 
                       Style="{StaticResource SectionHeaderStyle}"
                       Foreground="{StaticResource SuccessBrush}"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Пример с TextBox -->
                <Border Grid.Column="0" Style="{StaticResource DemoInnerBorder}">
                    <StackPanel>
                        <TextBlock Text="{res:LocalizationExtension Key=TwoWayBinding_TextBoxExample}" 
                                   Style="{StaticResource SubHeaderStyle}"
                                   Foreground="{StaticResource AccentBrush}"/>

                        <TextBlock Text="{res:LocalizationExtension Key=TwoWayBinding_EnterText}" 
                                   Foreground="{StaticResource TextBrush}" 
                                   Margin="0,5"/>
                        <TextBox Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                 Margin="0,0,0,10"
                                 Background="{StaticResource PanelBrush}"/>

                        <TextBlock Text="{res:LocalizationExtension Key=TwoWayBinding_TextFromViewModel}" 
                                   Foreground="{StaticResource TextBrush}" 
                                   Margin="0,5"/>
                        <TextBox Text="{Binding InputText, Mode=OneWay}" 
                                 IsReadOnly="True" 
                                 Background="{StaticResource PanelBrush}"
                                 Opacity="0.8"
                                 Margin="0,0,0,10"/>

                        <Border Background="{StaticResource PanelBrush}" 
                                Padding="10" 
                                CornerRadius="5"
                                Margin="0,5">
                            <StackPanel>
                                <TextBlock Text="{res:LocalizationExtension Key=TwoWayBinding_TextLength}" 
                                          Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="{Binding InputText.Length}" 
                                          Style="{StaticResource ValueDisplayStyle}"
                                          HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{res:LocalizationExtension Key=TwoWayBinding_SyncDesc}" 
                                   Style="{StaticResource DescriptionStyle}"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Пример с CheckBox -->
                <Border Grid.Column="1" Style="{StaticResource DemoInnerBorder}">
                    <StackPanel>
                        <TextBlock Text="{res:LocalizationExtension Key=TwoWayBinding_CheckBoxExample}" 
                                   Style="{StaticResource SubHeaderStyle}"
                                   Foreground="{StaticResource WarningBrush}"/>

                        <CheckBox Content="{res:LocalizationExtension Key=TwoWayBinding_Active}" 
                                  IsChecked="{Binding IsChecked, Mode=TwoWay}" 
                                  Margin="0,10" 
                                  FontSize="14"
                                  Foreground="{StaticResource TextBrush}"/>

                        <Border Background="{StaticResource PanelBrush}" 
                                Padding="15" 
                                Margin="0,10"
                                CornerRadius="5">
                            <StackPanel>
                                <TextBlock Text="{res:LocalizationExtension Key=TwoWayBinding_StateInViewModel}" 
                                          FontWeight="Bold"
                                          Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="{Binding IsChecked}" 
                                          Style="{StaticResource ValueDisplayStyle}"
                                          HorizontalAlignment="Center"/>
                                <TextBlock Text="{res:LocalizationExtension Key=TwoWayBinding_StateDesc}"
                                          Style="{StaticResource DescriptionStyle}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{res:LocalizationExtension Key=TwoWayBinding_CheckBoxDesc}" 
                                   Style="{StaticResource DescriptionStyle}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Пример с полями Person -->
                <Border Grid.Column="0" Style="{StaticResource DemoInnerBorder}">
                    <StackPanel>
                        <TextBlock Text="{res:LocalizationExtension Key=TwoWayBinding_EditPerson}" 
                                   Style="{StaticResource SubHeaderStyle}"
                                   Foreground="{StaticResource SuccessBrush}"/>

                        <TextBlock Text="{res:LocalizationExtension Key=TwoWayBinding_FirstName}" 
                                   Foreground="{StaticResource TextBrush}" Margin="0,5"/>
                        <TextBox Text="{Binding Person.FirstName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                 Margin="0,0,0,10"
                                 Background="{StaticResource PanelBrush}"/>

                        <TextBlock Text="{res:LocalizationExtension Key=TwoWayBinding_LastName}" 
                                   Foreground="{StaticResource TextBrush}" Margin="0,5"/>
                        <TextBox Text="{Binding Person.LastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                 Margin="0,0,0,10"
                                 Background="{StaticResource PanelBrush}"/>

                        <TextBlock Text="{res:LocalizationExtension Key=TwoWayBinding_Age}" 
                                   Foreground="{StaticResource TextBrush}" Margin="0,5"/>
                        <TextBox Text="{Binding Person.Age, Mode=TwoWay}" 
                                 Margin="0,0,0,10"
                                 Background="{StaticResource PanelBrush}"/>

                        <CheckBox Content="{res:LocalizationExtension Key=TwoWayBinding_IsStudent}" 
                                  IsChecked="{Binding Person.IsStudent, Mode=TwoWay}" 
                                  Margin="0,5"
                                  Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Отображение текущих значений -->
                <Border Grid.Column="1" Style="{StaticResource DemoInnerBorder}" 
                        Background="{StaticResource PanelBrush}">
                    <StackPanel>
                        <TextBlock Text="{res:LocalizationExtension Key=TwoWayBinding_CurrentValues}" 
                                   Style="{StaticResource SubHeaderStyle}"
                                   Foreground="{StaticResource AccentBrush}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" 
                                       Text="{res:LocalizationExtension Key=TwoWayBinding_FirstName}" 
                                       FontWeight="Bold" Margin="0,5" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" 
                                       Text="{Binding Person.FirstName}" 
                                       Margin="10,5" Foreground="{StaticResource SuccessBrush}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" 
                                       Text="{res:LocalizationExtension Key=TwoWayBinding_LastName}" 
                                       FontWeight="Bold" Margin="0,5" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" 
                                       Text="{Binding Person.LastName}" 
                                       Margin="10,5" Foreground="{StaticResource SuccessBrush}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" 
                                       Text="{res:LocalizationExtension Key=TwoWayBinding_Age}" 
                                       FontWeight="Bold" Margin="0,5" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" 
                                       Text="{Binding Person.Age}" 
                                       Margin="10,5" Foreground="{StaticResource SuccessBrush}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" 
                                       Text="{res:LocalizationExtension Key=TwoWayBinding_IsStudent}" 
                                       FontWeight="Bold" Margin="0,5" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" 
                                       Text="{Binding Person.IsStudent}" 
                                       Margin="10,5" Foreground="{StaticResource SuccessBrush}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" 
                                       Text="{res:LocalizationExtension Key=OneWayBinding_FullName}" 
                                       FontWeight="Bold" Margin="0,5" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" 
                                       Text="{Binding Person.FullName}" 
                                       Margin="10,5" Foreground="{StaticResource AccentLightBrush}" 
                                       FontWeight="Bold"/>
                        </Grid>

                        <TextBlock Text="{res:LocalizationExtension Key=TwoWayBinding_RealTimeUpdate}" 
                                   Style="{StaticResource DescriptionStyle}"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Цветная рамка для описания -->
            <Border Background="{StaticResource PanelBrush}" 
                    Padding="20" 
                    Margin="5,10"
                    CornerRadius="8"
                    BorderBrush="{StaticResource SuccessBrush}"
                    BorderThickness="2">
                <StackPanel>
                    <TextBlock Text="{res:LocalizationExtension Key=TwoWayBinding_DescriptionTitle}" 
                              FontSize="16" 
                              FontWeight="Bold"
                              Foreground="{StaticResource SuccessBrush}"
                              Margin="0,0,0,10"/>
                    <TextBlock Text="{res:LocalizationExtension Key=TwoWayBinding_DescriptionText}" 
                              TextWrapping="Wrap" 
                              Foreground="{StaticResource TextBrush}"
                              Margin="0,0,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="5">
                            <TextBlock Text="{res:LocalizationExtension Key=TwoWayBinding_UIToViewModel}" 
                                      FontWeight="Bold"
                                      Foreground="{StaticResource WarningBrush}"/>
                            <TextBlock Text="{res:LocalizationExtension Key=TwoWayBinding_UIChange1}" 
                                      Style="{StaticResource DescriptionStyle}"/>
                            <TextBlock Text="{res:LocalizationExtension Key=TwoWayBinding_UIChange2}" 
                                      Style="{StaticResource DescriptionStyle}"/>
                            <TextBlock Text="{res:LocalizationExtension Key=TwoWayBinding_UIChange3}" 
                                      Style="{StaticResource DescriptionStyle}"/>
                            <TextBlock Text="{res:LocalizationExtension Key=TwoWayBinding_UIChange4}" 
                                      Style="{StaticResource DescriptionStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="5">
                            <TextBlock Text="{res:LocalizationExtension Key=TwoWayBinding_ViewModelToUI}" 
                                      FontWeight="Bold"
                                      Foreground="{StaticResource SuccessBrush}"/>
                            <TextBlock Text="{res:LocalizationExtension Key=TwoWayBinding_VMChange1}" 
                                      Style="{StaticResource DescriptionStyle}"/>
                            <TextBlock Text="{res:LocalizationExtension Key=TwoWayBinding_VMChange2}" 
                                      Style="{StaticResource DescriptionStyle}"/>
                            <TextBlock Text="{res:LocalizationExtension Key=TwoWayBinding_VMChange3}" 
                                      Style="{StaticResource DescriptionStyle}"/>
                            <TextBlock Text="{res:LocalizationExtension Key=TwoWayBinding_VMChange4}" 
                                      Style="{StaticResource DescriptionStyle}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{res:LocalizationExtension Key=TwoWayBinding_Advantages}" 
                                      FontWeight="Bold"
                                      Foreground="{StaticResource SuccessBrush}"/>
                            <TextBlock Text="{res:LocalizationExtension Key=TwoWayBinding_Adv1}" 
                                      Style="{StaticResource DescriptionStyle}"/>
                            <TextBlock Text="{res:LocalizationExtension Key=TwoWayBinding_Adv2}" 
                                      Style="{StaticResource DescriptionStyle}"/>
                            <TextBlock Text="{res:LocalizationExtension Key=TwoWayBinding_Adv3}" 
                                      Style="{StaticResource DescriptionStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{res:LocalizationExtension Key=TwoWayBinding_Features}" 
                                      FontWeight="Bold"
                                      Foreground="{StaticResource WarningBrush}"/>
                            <TextBlock Text="{res:LocalizationExtension Key=TwoWayBinding_Feat1}" 
                                      Style="{StaticResource DescriptionStyle}"/>
                            <TextBlock Text="{res:LocalizationExtension Key=TwoWayBinding_Feat2}" 
                                      Style="{StaticResource DescriptionStyle}"/>
                            <TextBlock Text="{res:LocalizationExtension Key=TwoWayBinding_Feat3}" 
                                      Style="{StaticResource DescriptionStyle}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>