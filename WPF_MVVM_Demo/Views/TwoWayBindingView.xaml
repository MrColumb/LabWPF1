<UserControl x:Class="WPF_MVVM_Demo.Views.TwoWayBindingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="Transparent">

    <UserControl.Resources>
        <Style TargetType="Border" x:Key="DemoInnerBorder">
            <Setter Property="Background" Value="{StaticResource PanelLightBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" Opacity="0.3" ShadowDepth="3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock" x:Key="DescriptionStyle">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Opacity" Value="0.8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="SubHeaderStyle">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="SectionHeaderStyle">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="ValueDisplayStyle">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  Background="Transparent">
        <StackPanel Margin="5">
            <TextBlock Text="{Tr 'TwoWay.Title', DefaultText='TwoWay Binding'}" 
                       Style="{StaticResource SectionHeaderStyle}"
                       Foreground="{StaticResource SuccessBrush}"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Пример с TextBox -->
                <Border Grid.Column="0" Style="{StaticResource DemoInnerBorder}">
                    <StackPanel>
                        <TextBlock Text="{Tr 'TwoWay.TextBox.Title', DefaultText='TextBox example (TwoWay)'}" 
                                   Style="{StaticResource SubHeaderStyle}"
                                   Foreground="{StaticResource AccentBrush}"/>

                        <TextBlock Text="{Tr 'TwoWay.TextBox.EnterText', DefaultText='Enter text:'}" 
                                   Foreground="{StaticResource TextBrush}" 
                                   Margin="0,5"/>
                        <TextBox Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                 Margin="0,0,0,10"
                                 Background="{StaticResource PanelBrush}"/>

                        <TextBlock Text="{Tr 'TwoWay.TextBox.FromVm', DefaultText='Text from ViewModel:'}" 
                                   Foreground="{StaticResource TextBrush}" 
                                   Margin="0,5"/>
                        <TextBox Text="{Binding InputText, Mode=OneWay}" 
                                 IsReadOnly="True" 
                                 Background="{StaticResource PanelBrush}"
                                 Opacity="0.8"
                                 Margin="0,0,0,10"/>

                        <Border Background="{StaticResource PanelBrush}" 
                                Padding="10" 
                                CornerRadius="5"
                                Margin="0,5">
                            <StackPanel>
                                <TextBlock Text="{Tr 'TwoWay.TextBox.Length', DefaultText='Text length:'}" 
                                          Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="{Binding InputText.Length}" 
                                          Style="{StaticResource ValueDisplayStyle}"
                                          HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Tr 'TwoWay.TextBox.SyncHint', DefaultText='Changes are synchronized in both directions'}" 
                                   Style="{StaticResource DescriptionStyle}"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Пример с CheckBox -->
                <Border Grid.Column="1" Style="{StaticResource DemoInnerBorder}">
                    <StackPanel>
                        <TextBlock Text="{Tr 'TwoWay.CheckBox.Title', DefaultText='CheckBox example (TwoWay)'}" 
                                   Style="{StaticResource SubHeaderStyle}"
                                   Foreground="{StaticResource WarningBrush}"/>

                        <CheckBox Content="{Tr 'TwoWay.CheckBox.Active', DefaultText='Active'}" 
                                  IsChecked="{Binding IsChecked, Mode=TwoWay}" 
                                  Margin="0,10" 
                                  FontSize="14"
                                  Foreground="{StaticResource TextBrush}"/>

                        <Border Background="{StaticResource PanelBrush}" 
                                Padding="15" 
                                Margin="0,10"
                                CornerRadius="5">
                            <StackPanel>
                                <TextBlock Text="{Tr 'TwoWay.CheckBox.State', DefaultText='State in ViewModel:'}" 
                                          FontWeight="Bold"
                                          Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="{Binding IsChecked}" 
                                          Style="{StaticResource ValueDisplayStyle}"
                                          HorizontalAlignment="Center"/>
                                <TextBlock Text="{Tr 'TwoWay.CheckBox.StateHint', DefaultText='True - enabled, False - disabled'}"
                                          Style="{StaticResource DescriptionStyle}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Tr 'TwoWay.CheckBox.SyncHint', DefaultText='When CheckBox changes, ViewModel updates and vice versa'}" 
                                   Style="{StaticResource DescriptionStyle}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Пример с полями Person -->
                <Border Grid.Column="0" Style="{StaticResource DemoInnerBorder}">
                    <StackPanel>
                        <TextBlock Text="{Tr 'TwoWay.PersonEdit.Title', DefaultText='Edit Person (TwoWay)'}" 
                                   Style="{StaticResource SubHeaderStyle}"
                                   Foreground="{StaticResource SuccessBrush}"/>

                        <TextBlock Text="{Tr 'TwoWay.PersonEdit.FirstName', DefaultText='First name:'}" Foreground="{StaticResource TextBrush}" Margin="0,5"/>
                        <TextBox Text="{Binding Person.FirstName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                 Margin="0,0,0,10"
                                 Background="{StaticResource PanelBrush}"/>

                        <TextBlock Text="{Tr 'TwoWay.PersonEdit.LastName', DefaultText='Last name:'}" Foreground="{StaticResource TextBrush}" Margin="0,5"/>
                        <TextBox Text="{Binding Person.LastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                 Margin="0,0,0,10"
                                 Background="{StaticResource PanelBrush}"/>

                        <TextBlock Text="{Tr 'TwoWay.PersonEdit.Age', DefaultText='Age:'}" Foreground="{StaticResource TextBrush}" Margin="0,5"/>
                        <TextBox Text="{Binding Person.Age, Mode=TwoWay}" 
                                 Margin="0,0,0,10"
                                 Background="{StaticResource PanelBrush}"/>

                        <CheckBox Content="{Tr 'TwoWay.PersonEdit.Student', DefaultText='Student'}" 
                                  IsChecked="{Binding Person.IsStudent, Mode=TwoWay}" 
                                  Margin="0,5"
                                  Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Отображение текущих значений -->
                <Border Grid.Column="1" Style="{StaticResource DemoInnerBorder}" 
                        Background="{StaticResource PanelBrush}">
                    <StackPanel>
                        <TextBlock Text="{Tr 'TwoWay.PersonValues.Title', DefaultText='Current Person values:'}" 
                                   Style="{StaticResource SubHeaderStyle}"
                                   Foreground="{StaticResource AccentBrush}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Tr 'TwoWay.PersonValues.FirstName', DefaultText='First name:'}" FontWeight="Bold" Margin="0,5" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Person.FirstName}" Margin="10,5" Foreground="{StaticResource SuccessBrush}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Tr 'TwoWay.PersonValues.LastName', DefaultText='Last name:'}" FontWeight="Bold" Margin="0,5" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Person.LastName}" Margin="10,5" Foreground="{StaticResource SuccessBrush}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Tr 'TwoWay.PersonValues.Age', DefaultText='Age:'}" FontWeight="Bold" Margin="0,5" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Person.Age}" Margin="10,5" Foreground="{StaticResource SuccessBrush}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{Tr 'TwoWay.PersonValues.Student', DefaultText='Student:'}" FontWeight="Bold" Margin="0,5" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Person.IsStudent}" Margin="10,5" Foreground="{StaticResource SuccessBrush}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{Tr 'TwoWay.PersonValues.FullName', DefaultText='Full name:'}" FontWeight="Bold" Margin="0,5" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Person.FullName}" Margin="10,5" Foreground="{StaticResource AccentLightBrush}" FontWeight="Bold"/>
                        </Grid>

                        <TextBlock Text="{Tr 'TwoWay.PersonValues.Realtime', DefaultText='* Updates in real time'}" 
                                   Style="{StaticResource DescriptionStyle}"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Цветная рамка для описания -->
            <Border Background="{StaticResource PanelBrush}" 
                    Padding="20" 
                    Margin="5,10"
                    CornerRadius="8"
                    BorderBrush="{StaticResource SuccessBrush}"
                    BorderThickness="2">
                <StackPanel>
                    <TextBlock Text="{Tr 'TwoWay.Info.Title', DefaultText='TwoWay Binding Description'}" 
                              FontSize="16" 
                              FontWeight="Bold"
                              Foreground="{StaticResource SuccessBrush}"
                              Margin="0,0,0,10"/>
                    <TextBlock Text="{Tr 'TwoWay.Info.Description', DefaultText='TwoWay binding synchronizes data in both directions:'}" 
                              TextWrapping="Wrap" 
                              Foreground="{StaticResource TextBrush}"
                              Margin="0,0,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="5">
                            <TextBlock Text="⬇️ UI → ViewModel" 
                                      FontWeight="Bold"
                                      Foreground="{StaticResource WarningBrush}"/>
                            <TextBlock Text="{Tr 'TwoWay.Info.UiToVm.TextBox', DefaultText='• Text field changes'}" 
                                      Style="{StaticResource DescriptionStyle}"/>
                            <TextBlock Text="{Tr 'TwoWay.Info.UiToVm.CheckBox', DefaultText='• CheckBox toggles'}" 
                                      Style="{StaticResource DescriptionStyle}"/>
                            <TextBlock Text="{Tr 'TwoWay.Info.UiToVm.ComboBox', DefaultText='• ComboBox selection'}" 
                                      Style="{StaticResource DescriptionStyle}"/>
                            <TextBlock Text="{Tr 'TwoWay.Info.UiToVm.Model', DefaultText='• Data is sent to the model'}" 
                                      Style="{StaticResource DescriptionStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="5">
                            <TextBlock Text="⬆️ ViewModel → UI" 
                                      FontWeight="Bold"
                                      Foreground="{StaticResource SuccessBrush}"/>
                            <TextBlock Text="{Tr 'TwoWay.Info.VmToUi.Code', DefaultText='• Data updates in code'}" 
                                      Style="{StaticResource DescriptionStyle}"/>
                            <TextBlock Text="{Tr 'TwoWay.Info.VmToUi.Load', DefaultText='• Loading new values'}" 
                                      Style="{StaticResource DescriptionStyle}"/>
                            <TextBlock Text="{Tr 'TwoWay.Info.VmToUi.State', DefaultText='• State changes'}" 
                                      Style="{StaticResource DescriptionStyle}"/>
                            <TextBlock Text="{Tr 'TwoWay.Info.VmToUi.Ui', DefaultText='• UI updates'}" 
                                      Style="{StaticResource DescriptionStyle}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Tr 'TwoWay.Info.Advantages.Title', DefaultText='Advantages:'}" 
                                      FontWeight="Bold"
                                      Foreground="{StaticResource SuccessBrush}"/>
                            <TextBlock Text="{Tr 'TwoWay.Info.Advantages.Sync', DefaultText='• Automatic synchronization'}" 
                                      Style="{StaticResource DescriptionStyle}"/>
                            <TextBlock Text="{Tr 'TwoWay.Info.Advantages.NoCode', DefaultText='• No manual update code needed'}" 
                                      Style="{StaticResource DescriptionStyle}"/>
                            <TextBlock Text="{Tr 'TwoWay.Info.Advantages.Fresh', DefaultText='• Data is always current'}" 
                                      Style="{StaticResource DescriptionStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Tr 'TwoWay.Info.Notes.Title', DefaultText='Notes:'}" 
                                      FontWeight="Bold"
                                      Foreground="{StaticResource WarningBrush}"/>
                            <TextBlock Text="{Tr 'TwoWay.Info.Notes.Trigger', DefaultText='• UpdateSourceTrigger controls update timing'}" 
                                      Style="{StaticResource DescriptionStyle}"/>
                            <TextBlock Text="{Tr 'TwoWay.Info.Notes.Optimize', DefaultText='• Can be adjusted for optimization'}" 
                                      Style="{StaticResource DescriptionStyle}"/>
                            <TextBlock Text="{Tr 'TwoWay.Info.Notes.Notify', DefaultText='• Requires INotifyPropertyChanged'}" 
                                      Style="{StaticResource DescriptionStyle}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>