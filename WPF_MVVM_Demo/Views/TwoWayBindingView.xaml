<UserControl x:Class="WPF_MVVM_Demo.Views.TwoWayBindingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="Transparent">

    <UserControl.Resources>
        <Style TargetType="Border" x:Key="DemoInnerBorder">
            <Setter Property="Background" Value="{StaticResource PanelLightBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" Opacity="0.3" ShadowDepth="3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock" x:Key="DescriptionStyle">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Opacity" Value="0.8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="SubHeaderStyle">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="SectionHeaderStyle">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="ValueDisplayStyle">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  Background="Transparent">
        <StackPanel Margin="5">
            <TextBlock Text="{DynamicResource TwoWayBindingTitle}" 
                       Style="{StaticResource SectionHeaderStyle}"
                       Foreground="{StaticResource SuccessBrush}"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Пример с TextBox -->
                <Border Grid.Column="0" Style="{StaticResource DemoInnerBorder}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource TextBoxExample}" 
                                   Style="{StaticResource SubHeaderStyle}"
                                   Foreground="{StaticResource AccentBrush}"/>

                        <TextBlock Text="{DynamicResource EnterText}" 
                                   Foreground="{StaticResource TextBrush}" 
                                   Margin="0,5"/>
                        <TextBox Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                 Margin="0,0,0,10"
                                 Background="{StaticResource PanelBrush}"/>

                        <TextBlock Text="{DynamicResource TextFromViewModel}" 
                                   Foreground="{StaticResource TextBrush}" 
                                   Margin="0,5"/>
                        <TextBox Text="{Binding InputText, Mode=OneWay}" 
                                 IsReadOnly="True" 
                                 Background="{StaticResource PanelBrush}"
                                 Opacity="0.8"
                                 Margin="0,0,0,10"/>

                        <Border Background="{StaticResource PanelBrush}" 
                                Padding="10" 
                                CornerRadius="5"
                                Margin="0,5">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource TextLength}" 
                                          Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="{Binding TextLength}" 
                                          Style="{StaticResource ValueDisplayStyle}"
                                          HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{DynamicResource AutoSync}" 
                                   Style="{StaticResource DescriptionStyle}"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Пример с CheckBox -->
                <Border Grid.Column="1" Style="{StaticResource DemoInnerBorder}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource CheckBoxExample}" 
                                   Style="{StaticResource SubHeaderStyle}"
                                   Foreground="{StaticResource WarningBrush}"/>

                        <CheckBox Content="{DynamicResource Active}" 
                                  IsChecked="{Binding IsChecked, Mode=TwoWay}" 
                                  Margin="0,10" 
                                  FontSize="14"
                                  Foreground="{StaticResource TextBrush}"/>

                        <Border Background="{StaticResource PanelBrush}" 
                                Padding="15" 
                                Margin="0,10"
                                CornerRadius="5">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource StateInViewModel}" 
                                          FontWeight="Bold"
                                          Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="{Binding IsChecked}" 
                                          Style="{StaticResource ValueDisplayStyle}"
                                          HorizontalAlignment="Center"/>
                                <TextBlock Text="True - включено, False - выключено"
                                          Style="{StaticResource DescriptionStyle}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{DynamicResource AutoSync}" 
                                   Style="{StaticResource DescriptionStyle}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Пример с полями Person -->
                <Border Grid.Column="0" Style="{StaticResource DemoInnerBorder}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource EditPerson}" 
                                   Style="{StaticResource SubHeaderStyle}"
                                   Foreground="{StaticResource SuccessBrush}"/>

                        <TextBlock Text="{DynamicResource FirstName}" Foreground="{StaticResource TextBrush}" Margin="0,5"/>
                        <TextBox Text="{Binding Person.FirstName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                 Margin="0,0,0,10"
                                 Background="{StaticResource PanelBrush}"/>

                        <TextBlock Text="{DynamicResource LastName}" Foreground="{StaticResource TextBrush}" Margin="0,5"/>
                        <TextBox Text="{Binding Person.LastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                 Margin="0,0,0,10"
                                 Background="{StaticResource PanelBrush}"/>

                        <TextBlock Text="{DynamicResource Age}" Foreground="{StaticResource TextBrush}" Margin="0,5"/>
                        <TextBox Text="{Binding Person.Age, Mode=TwoWay}" 
                                 Margin="0,0,0,10"
                                 Background="{StaticResource PanelBrush}"/>

                        <CheckBox Content="{DynamicResource Student}" 
                                  IsChecked="{Binding Person.IsStudent, Mode=TwoWay}" 
                                  Margin="0,5"
                                  Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Отображение текущих значений -->
                <Border Grid.Column="1" Style="{StaticResource DemoInnerBorder}" 
                        Background="{StaticResource PanelBrush}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource CurrentPersonValues}" 
                                   Style="{StaticResource SubHeaderStyle}"
                                   Foreground="{StaticResource AccentBrush}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource FirstName}" FontWeight="Bold" Margin="0,5" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Person.FirstName}" Margin="10,5" Foreground="{StaticResource SuccessBrush}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource LastName}" FontWeight="Bold" Margin="0,5" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Person.LastName}" Margin="10,5" Foreground="{StaticResource SuccessBrush}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Age}" FontWeight="Bold" Margin="0,5" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Person.Age}" Margin="10,5" Foreground="{StaticResource SuccessBrush}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource StudentStatus}" FontWeight="Bold" Margin="0,5" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Person.IsStudent}" Margin="10,5" Foreground="{StaticResource SuccessBrush}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource FullName}" FontWeight="Bold" Margin="0,5" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Person.FullName}" Margin="10,5" Foreground="{StaticResource AccentLightBrush}" FontWeight="Bold"/>
                        </Grid>

                        <TextBlock Text="{DynamicResource RealTimeUpdate}" 
                                   Style="{StaticResource DescriptionStyle}"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Цветная рамка для описания -->
            <Border Background="{StaticResource PanelBrush}" 
                    Padding="20" 
                    Margin="5,10"
                    CornerRadius="8"
                    BorderBrush="{StaticResource SuccessBrush}"
                    BorderThickness="2">
                <StackPanel>
                    <TextBlock Text="📖 Описание двухсторонней привязки (TwoWay)" 
                              FontSize="16" 
                              FontWeight="Bold"
                              Foreground="{StaticResource SuccessBrush}"
                              Margin="0,0,0,10"/>
                    <TextBlock Text="{DynamicResource TwoWayDescription}" 
                              TextWrapping="Wrap" 
                              Foreground="{StaticResource TextBrush}"
                              Margin="0,0,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="5">
                            <TextBlock Text="{DynamicResource UIToViewModel}" 
                                      FontWeight="Bold"
                                      Foreground="{StaticResource WarningBrush}"/>
                            <TextBlock Text="• Изменение в текстовом поле" 
                                      Style="{StaticResource DescriptionStyle}"/>
                            <TextBlock Text="• Переключение CheckBox" 
                                      Style="{StaticResource DescriptionStyle}"/>
                            <TextBlock Text="• Выбор в ComboBox" 
                                      Style="{StaticResource DescriptionStyle}"/>
                            <TextBlock Text="• Данные передаются в модель" 
                                      Style="{StaticResource DescriptionStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="5">
                            <TextBlock Text="{DynamicResource ViewModelToUI}" 
                                      FontWeight="Bold"
                                      Foreground="{StaticResource SuccessBrush}"/>
                            <TextBlock Text="• Обновление данных в коде" 
                                      Style="{StaticResource DescriptionStyle}"/>
                            <TextBlock Text="• Загрузка новых значений" 
                                      Style="{StaticResource DescriptionStyle}"/>
                            <TextBlock Text="• Изменение состояния" 
                                      Style="{StaticResource DescriptionStyle}"/>
                            <TextBlock Text="• Интерфейс обновляется" 
                                      Style="{StaticResource DescriptionStyle}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Advantages}" 
                                      FontWeight="Bold"
                                      Foreground="{StaticResource SuccessBrush}"/>
                            <TextBlock Text="{DynamicResource AutoSync}" 
                                      Style="{StaticResource DescriptionStyle}"/>
                            <TextBlock Text="{DynamicResource NoCodeNeeded}" 
                                      Style="{StaticResource DescriptionStyle}"/>
                            <TextBlock Text="{DynamicResource DataAlwaysActual}" 
                                      Style="{StaticResource DescriptionStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{DynamicResource Features}" 
                                      FontWeight="Bold"
                                      Foreground="{StaticResource WarningBrush}"/>
                            <TextBlock Text="{DynamicResource UpdateSourceTrigger}" 
                                      Style="{StaticResource DescriptionStyle}"/>
                            <TextBlock Text="{DynamicResource CanDisable}" 
                                      Style="{StaticResource DescriptionStyle}"/>
                            <TextBlock Text="{DynamicResource RequiresINPC}" 
                                      Style="{StaticResource DescriptionStyle}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>