<UserControl x:Class="WPF_MVVM_Demo.Views.OneTimeBindingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="Transparent">

    <UserControl.Resources>
        <Style TargetType="Border" x:Key="DemoInnerBorder">
            <Setter Property="Background" Value="{StaticResource PanelLightBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" Opacity="0.3" ShadowDepth="3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock" x:Key="DescriptionStyle">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Opacity" Value="0.8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="ValueDisplayStyle">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
        </Style>

        <Style x:Key="OneTimeButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FrozenValueStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  Background="Transparent">
        <StackPanel Margin="5">
            <TextBlock Text="{Tr 'OneTime.Title', DefaultText='OneTime Binding'}" 
                       Style="{StaticResource SectionHeaderStyle}"
                       Foreground="{StaticResource WarningBrush}"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Демонстрация OneTime привязки -->
                <Border Grid.Column="0" Style="{StaticResource DemoInnerBorder}">
                    <StackPanel>
                        <TextBlock Text="{Tr 'OneTime.Frozen.Title', DefaultText='OneTime Binding (Frozen data)'}" 
                                   Style="{StaticResource SubHeaderStyle}"
                                   Foreground="{StaticResource DangerBrush}"/>

                        <Border Style="{StaticResource FrozenValueStyle}">
                            <StackPanel>
                                <TextBlock Text="{Tr 'OneTime.Frozen.CurrentTime', DefaultText='Current time (OneTime):'}" 
                                          Foreground="{StaticResource TextBrush}" 
                                          FontWeight="Bold"
                                          Margin="0,5"/>
                                <TextBlock Text="{Binding CurrentTime, Mode=OneTime}" 
                                           Style="{StaticResource ValueDisplayStyle}"
                                           FontSize="16"
                                           Foreground="{StaticResource DangerBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,5"/>
                                <TextBlock Text="{Tr 'OneTime.Frozen.NotChange', DefaultText='* This value will NOT change'}" 
                                          Style="{StaticResource DescriptionStyle}"
                                          Foreground="{StaticResource DangerBrush}"
                                          HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource FrozenValueStyle}" Margin="0,10">
                            <StackPanel>
                                <TextBlock Text="{Tr 'OneTime.Frozen.StaticText', DefaultText='Static text (OneTime):'}" 
                                          Foreground="{StaticResource TextBrush}"
                                          FontWeight="Bold"
                                          Margin="0,5"/>
                                <TextBlock Text="{Binding StaticText, Mode=OneTime}" 
                                           Style="{StaticResource DescriptionStyle}"
                                           FontSize="14"
                                           Foreground="{StaticResource DangerBrush}"
                                           TextWrapping="Wrap"
                                           HorizontalAlignment="Center"
                                           Margin="0,5"/>
                            </StackPanel>
                        </Border>

                        <Button Content="{Tr 'OneTime.Frozen.UpdateTime', DefaultText='Update time in ViewModel'}" 
                                Command="{Binding UpdateTimeCommand}"
                                Margin="0,10" 
                                Padding="15,8"
                                Background="{StaticResource WarningBrush}"/>

                        <Border Background="{StaticResource PanelBrush}" 
                                Padding="10" 
                                Margin="0,5"
                                CornerRadius="5">
                            <StackPanel>
                                <TextBlock Text="{Tr 'OneTime.Frozen.Important', DefaultText='Important:'}" 
                                          FontWeight="Bold"
                                          Foreground="{StaticResource WarningBrush}"/>
                                <TextBlock Text="{Tr 'OneTime.Frozen.Point1', DefaultText='• Clicking the button updates time in ViewModel'}" 
                                          Style="{StaticResource DescriptionStyle}"/>
                                <TextBlock Text="{Tr 'OneTime.Frozen.Point2', DefaultText='• OneTime binding does NOT react to changes'}" 
                                          Style="{StaticResource DescriptionStyle}"
                                          Foreground="{StaticResource DangerBrush}"/>
                                <TextBlock Text="{Tr 'OneTime.Frozen.Point3', DefaultText='• Value remains [apos]frozen[apos]'}" 
                                          Style="{StaticResource DescriptionStyle}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Сравнение с OneWay -->
                <Border Grid.Column="1" Style="{StaticResource DemoInnerBorder}">
                    <StackPanel>
                        <TextBlock Text="{Tr 'OneTime.Compare.Title', DefaultText='OneWay Binding (for comparison)'}" 
                                   Style="{StaticResource SubHeaderStyle}"
                                   Foreground="{StaticResource SuccessBrush}"/>

                        <Border Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource SuccessBrush}"
                                BorderThickness="2"
                                CornerRadius="5"
                                Padding="10"
                                Margin="5">
                            <StackPanel>
                                <TextBlock Text="{Tr 'OneTime.Compare.CurrentTime', DefaultText='Current time (OneWay):'}" 
                                          Foreground="{StaticResource TextBrush}"
                                          FontWeight="Bold"
                                          Margin="0,5"/>
                                <TextBlock Text="{Binding CurrentTime, Mode=OneWay}" 
                                           Style="{StaticResource ValueDisplayStyle}"
                                           FontSize="16"
                                           Foreground="{StaticResource SuccessBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,5"/>
                                <TextBlock Text="{Tr 'OneTime.Compare.Updates', DefaultText='* This value UPDATES'}" 
                                          Style="{StaticResource DescriptionStyle}"
                                          Foreground="{StaticResource SuccessBrush}"
                                          HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource SuccessBrush}"
                                BorderThickness="2"
                                CornerRadius="5"
                                Padding="10"
                                Margin="5,10">
                            <StackPanel>
                                <TextBlock Text="{Tr 'OneTime.Compare.StaticText', DefaultText='Static text (OneWay):'}" 
                                          Foreground="{StaticResource TextBrush}"
                                          FontWeight="Bold"
                                          Margin="0,5"/>
                                <TextBlock Text="{Binding StaticText, Mode=OneWay}" 
                                           Style="{StaticResource DescriptionStyle}"
                                           FontSize="14"
                                           Foreground="{StaticResource SuccessBrush}"
                                           TextWrapping="Wrap"
                                           HorizontalAlignment="Center"
                                           Margin="0,5"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PanelBrush}" 
                                Padding="10" 
                                Margin="0,5"
                                CornerRadius="5">
                            <StackPanel>
                                <TextBlock Text="{Tr 'OneTime.Compare.Features', DefaultText='OneWay features:'}" 
                                          FontWeight="Bold"
                                          Foreground="{StaticResource SuccessBrush}"/>
                                <TextBlock Text="{Tr 'OneTime.Compare.Point1', DefaultText='• Tracks changes in ViewModel'}" 
                                          Style="{StaticResource DescriptionStyle}"/>
                                <TextBlock Text="{Tr 'OneTime.Compare.Point2', DefaultText='• Updates automatically'}" 
                                          Style="{StaticResource DescriptionStyle}"/>
                                <TextBlock Text="{Tr 'OneTime.Compare.Point3', DefaultText='• Dynamic display'}" 
                                          Style="{StaticResource DescriptionStyle}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Данные Person с OneTime -->
                <Border Grid.Column="0" Style="{StaticResource DemoInnerBorder}">
                    <StackPanel>
                        <TextBlock Text="{Tr 'OneTime.Person.Title', DefaultText='Person data (OneTime)'}" 
                                   Style="{StaticResource SubHeaderStyle}"
                                   Foreground="{StaticResource DangerBrush}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Tr 'OneTime.Person.FirstName', DefaultText='First name:'}" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="5"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Person.FirstName, Mode=OneTime}" Margin="10,5" Foreground="{StaticResource DangerBrush}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Tr 'OneTime.Person.LastName', DefaultText='Last name:'}" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="5"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Person.LastName, Mode=OneTime}" Margin="10,5" Foreground="{StaticResource DangerBrush}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Tr 'OneTime.Person.Age', DefaultText='Age:'}" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="5"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Person.Age, Mode=OneTime}" Margin="10,5" Foreground="{StaticResource DangerBrush}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Email:" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="5"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Person.Email, Mode=OneTime}" Margin="10,5" Foreground="{StaticResource DangerBrush}"/>
                        </Grid>

                        <TextBlock Text="{Tr 'OneTime.Person.NotChange', DefaultText='These values will NOT change when data updates'}" 
                                   Style="{StaticResource DescriptionStyle}"
                                   Foreground="{StaticResource DangerBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,10"/>
                    </StackPanel>
                </Border>

                <!-- Область для изменения данных -->
                <Border Grid.Column="1" Style="{StaticResource DemoInnerBorder}" 
                        Background="{StaticResource PanelBrush}">
                    <StackPanel>
                        <TextBlock Text="{Tr 'OneTime.Edit.Title', DefaultText='Change data in ViewModel'}" 
                                   Style="{StaticResource SubHeaderStyle}"
                                   Foreground="{StaticResource SuccessBrush}"/>

                        <TextBlock Text="{Tr 'OneTime.Edit.NewName', DefaultText='New name:'}" 
                                   Foreground="{StaticResource TextBrush}" 
                                   Margin="0,5"/>
                        <TextBox x:Name="NewNameTextBox" 
                                 Text="" 
                                 Margin="0,0,0,10"
                                 Background="{StaticResource PanelLightBrush}"
                                 Foreground="{StaticResource TextBrush}"/>

                        <Button Content="{Tr 'OneTime.Edit.ChangeName', DefaultText='Change name in Person'}" 
                                Command="{Binding UpdatePersonNameCommand}"
                                CommandParameter="{Binding Text, ElementName=NewNameTextBox}"
                                Style="{StaticResource OneTimeButtonStyle}"
                                Background="{StaticResource SuccessBrush}"
                                Margin="0,5" 
                                Padding="15,8"/>

                        <Border Background="{StaticResource PanelLightBrush}" 
                                Padding="10" 
                                Margin="0,10"
                                CornerRadius="5">
                            <StackPanel>
                                <TextBlock Text="{Tr 'OneTime.Edit.Result', DefaultText='Result:'}" 
                                          FontWeight="Bold"
                                          Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="{Tr 'OneTime.Edit.Result1', DefaultText='• In the left column (OneTime), name will NOT change'}" 
                                          Style="{StaticResource DescriptionStyle}"
                                          Foreground="{StaticResource DangerBrush}"/>
                                <TextBlock Text="{Tr 'OneTime.Edit.Result2', DefaultText='• In ViewModel data changed, but display is frozen'}" 
                                          Style="{StaticResource DescriptionStyle}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Background="{StaticResource PanelBrush}" 
                    Padding="20" 
                    Margin="5,10"
                    CornerRadius="8"
                    BorderBrush="{StaticResource WarningBrush}"
                    BorderThickness="2">
                <StackPanel>
                    <TextBlock Text="{Tr 'OneTime.Info.Title', DefaultText='OneTime Binding Description'}" 
                              FontSize="16" 
                              FontWeight="Bold"
                              Foreground="{StaticResource WarningBrush}"
                              Margin="0,0,0,10"/>
                    <TextBlock Text="{Tr 'OneTime.Info.Description', DefaultText='OneTime binding sets a value once when binding is created and does not track further changes. It is useful for static data or when you need a snapshot at load time.'}" 
                              TextWrapping="Wrap" 
                              Foreground="{StaticResource TextBrush}"
                              Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Tr 'OneTime.Info.Pros', DefaultText='Advantages:'}" 
                                      FontWeight="Bold"
                                      Foreground="{StaticResource SuccessBrush}"/>
                            <TextBlock Text="{Tr 'OneTime.Info.Pros1', DefaultText='• Minimal overhead'}" 
                                      Style="{StaticResource DescriptionStyle}"/>
                            <TextBlock Text="{Tr 'OneTime.Info.Pros2', DefaultText='• Does not track changes'}" 
                                      Style="{StaticResource DescriptionStyle}"/>
                            <TextBlock Text="{Tr 'OneTime.Info.Pros3', DefaultText='• Fast loading'}" 
                                      Style="{StaticResource DescriptionStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Tr 'OneTime.Info.Cons', DefaultText='Drawbacks:'}" 
                                      FontWeight="Bold"
                                      Foreground="{StaticResource DangerBrush}"/>
                            <TextBlock Text="{Tr 'OneTime.Info.Cons1', DefaultText='• Does not update'}" 
                                      Style="{StaticResource DescriptionStyle}"/>
                            <TextBlock Text="{Tr 'OneTime.Info.Cons2', DefaultText='• Initial value only'}" 
                                      Style="{StaticResource DescriptionStyle}"/>
                            <TextBlock Text="{Tr 'OneTime.Info.Cons3', DefaultText='• Not suitable for dynamic data'}" 
                                      Style="{StaticResource DescriptionStyle}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>