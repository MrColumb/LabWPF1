<Window x:Class="WPF_MVVM_Demo.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WPF_MVVM_Demo.ViewModels"
        xmlns:views="clr-namespace:WPF_MVVM_Demo.Views"
        Title="{Tr 'MainWindow.Title', DefaultText='WPF Bindings Demo'}" 
        Height="800" 
        Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundGradient}">

    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок с градиентом -->
        <Border Grid.Row="0"
                Background="{StaticResource PanelBrush}"
                CornerRadius="8"
                Padding="20"
                Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                <TextBlock Text="{Tr 'MainWindow.Header.Title', DefaultText='Lab #1: WPF Binding Modes'}" 
                          FontSize="24" 
                          FontWeight="Bold" 
                          Foreground="{StaticResource AccentBrush}"
                          HorizontalAlignment="Center"/>
                <TextBlock Text="{Tr 'MainWindow.Header.Subtitle', DefaultText='Demonstration of binding types and triggers'}"
                          FontSize="14"
                          Foreground="{StaticResource TextBrush}"
                          HorizontalAlignment="Center"
                          Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="20,0,0,0">
                    <TextBlock Text="{Tr 'MainWindow.Language.Label', DefaultText='Language:'}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <ComboBox Width="90"
                              ItemsSource="{Binding AvailableLanguages}"
                              SelectedItem="{Binding CurrentLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- TabControl -->
        <TabControl Grid.Row="1" 
                    SelectedItem="{Binding SelectedViewModel}"
                    Background="Transparent"
                    BorderThickness="0">

            <TabItem Header="{Tr 'MainWindow.Tab.Default', DefaultText='Default Binding'}">
                <Border Style="{StaticResource ContentBorderStyle}">
                    <views:DefaultBindingView DataContext="{Binding DefaultBindingVM}"/>
                </Border>
            </TabItem>

            <TabItem Header="{Tr 'MainWindow.Tab.TwoWay', DefaultText='TwoWay Binding'}">
                <Border Style="{StaticResource ContentBorderStyle}">
                    <views:TwoWayBindingView DataContext="{Binding TwoWayBindingVM}"/>
                </Border>
            </TabItem>

            <TabItem Header="{Tr 'MainWindow.Tab.OneTime', DefaultText='OneTime Binding'}">
                <Border Style="{StaticResource ContentBorderStyle}">
                    <views:OneTimeBindingView DataContext="{Binding OneTimeBindingVM}"/>
                </Border>
            </TabItem>

            <TabItem Header="{Tr 'MainWindow.Tab.OneWay', DefaultText='OneWay Bindings'}">
                <Border Style="{StaticResource ContentBorderStyle}">
                    <views:OneWayBindingView DataContext="{Binding OneWayBindingVM}"/>
                </Border>
            </TabItem>

            <TabItem Header="{Tr 'MainWindow.Tab.Triggers', DefaultText='Triggers'}">
                <Border Style="{StaticResource ContentBorderStyle}">
                    <views:TriggersView DataContext="{Binding TriggersVM}"/>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</Window>