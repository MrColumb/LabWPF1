<UserControl x:Class="WPF_MVVM_Demo.Views.DefaultBindingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:res="clr-namespace:WPF_MVVM_Demo.Resources"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="Transparent">

    <UserControl.Resources>
        <Style TargetType="Border" x:Key="DemoInnerBorder">
            <Setter Property="Background" Value="{StaticResource PanelLightBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="DescriptionStyle">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Opacity" Value="0.8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="SubHeaderStyle">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="SectionHeaderStyle">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  Background="Transparent">
        <StackPanel Margin="5">
            <TextBlock Text="{res:LocalizationExtension Key=DefaultBinding_Title}" 
                       Style="{StaticResource SectionHeaderStyle}"
                       Foreground="{StaticResource AccentBrush}"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Прямая привязка к элементам интерфейса -->
                <Border Grid.Column="0" Style="{StaticResource DemoInnerBorder}">
                    <StackPanel>
                        <TextBlock Text="{res:LocalizationExtension Key=DefaultBinding_DirectBindingTitle}" 
                                   Style="{StaticResource SubHeaderStyle}"
                                   Foreground="{StaticResource WarningBrush}"/>

                        <TextBlock Text="{res:LocalizationExtension Key=DefaultBinding_TextBoxLabel}" 
                                   Foreground="{StaticResource TextBrush}" 
                                   Margin="0,5"/>
                        <TextBox x:Name="DirectTextBox" 
                                 Text="{res:LocalizationExtension Key=DefaultBinding_TextBoxPlaceholder}" 
                                 Margin="0,0,0,10"
                                 Background="{StaticResource PanelBrush}"/>

                        <TextBlock Text="{res:LocalizationExtension Key=DefaultBinding_TextFromTextBox}" 
                                   Foreground="{StaticResource TextBrush}" 
                                   Margin="0,5"/>
                        <TextBox Text="{Binding Text, ElementName=DirectTextBox}" 
                                 IsReadOnly="True" 
                                 Background="{StaticResource PanelBrush}"
                                 Opacity="0.8"
                                 Margin="0,0,0,10"/>

                        <TextBlock Text="{res:LocalizationExtension Key=DefaultBinding_DirectBindingDesc}" 
                                   Style="{StaticResource DescriptionStyle}"/>
                    </StackPanel>
                </Border>

                <!-- Привязка через ViewModel -->
                <Border Grid.Column="1" Style="{StaticResource DemoInnerBorder}">
                    <StackPanel>
                        <TextBlock Text="{res:LocalizationExtension Key=DefaultBinding_ViewModelBindingTitle}" 
                                   Style="{StaticResource SubHeaderStyle}"
                                   Foreground="{StaticResource SuccessBrush}"/>

                        <TextBlock Text="{res:LocalizationExtension Key=DefaultBinding_FirstName}" 
                                   Foreground="{StaticResource TextBrush}" Margin="0,5"/>
                        <TextBox Text="{Binding Person.FirstName}" 
                                 Margin="0,0,0,10"
                                 Background="{StaticResource PanelBrush}"/>

                        <TextBlock Text="{res:LocalizationExtension Key=DefaultBinding_LastName}" 
                                   Foreground="{StaticResource TextBrush}" Margin="0,5"/>
                        <TextBox Text="{Binding Person.LastName}" 
                                 Margin="0,0,0,10"
                                 Background="{StaticResource PanelBrush}"/>

                        <TextBlock Text="{res:LocalizationExtension Key=DefaultBinding_Age}" 
                                   Foreground="{StaticResource TextBrush}" Margin="0,5"/>
                        <TextBox Text="{Binding Person.Age}" 
                                 Margin="0,0,0,10"
                                 Background="{StaticResource PanelBrush}"/>

                        <TextBlock Text="{res:LocalizationExtension Key=DefaultBinding_Email}" 
                                   Foreground="{StaticResource TextBrush}" Margin="0,5"/>
                        <TextBox Text="{Binding Person.Email}" 
                                 Margin="0,0,0,10"
                                 Background="{StaticResource PanelBrush}"/>

                        <CheckBox Content="{res:LocalizationExtension Key=DefaultBinding_IsStudent}" 
                                  IsChecked="{Binding Person.IsStudent}" 
                                  Margin="0,5"
                                  Foreground="{StaticResource TextBrush}"/>

                        <Border Background="{StaticResource PanelBrush}" 
                                Padding="10" 
                                Margin="0,10"
                                CornerRadius="5">
                            <StackPanel>
                                <TextBlock Text="{res:LocalizationExtension Key=DefaultBinding_FullName}" 
                                          FontWeight="Bold"
                                          Foreground="{StaticResource SuccessBrush}"/>
                                <TextBlock Text="{Binding Person.FullName}" 
                                          FontSize="16"
                                          Foreground="{StaticResource AccentLightBrush}"/>
                                <TextBlock Text="{res:LocalizationExtension Key=DefaultBinding_FullNameDesc}" 
                                          Style="{StaticResource DescriptionStyle}"
                                          Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Цветная рамка для описания -->
            <Border Background="{StaticResource PanelBrush}" 
                    Padding="20" 
                    Margin="5,10"
                    CornerRadius="8"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="2">
                <StackPanel>
                    <TextBlock Text="{res:LocalizationExtension Key=DefaultBinding_DescriptionTitle}" 
                              FontSize="16" 
                              FontWeight="Bold"
                              Foreground="{StaticResource AccentBrush}"
                              Margin="0,0,0,10"/>
                    <TextBlock Text="{res:LocalizationExtension Key=DefaultBinding_DescriptionText}" 
                              TextWrapping="Wrap" 
                              Foreground="{StaticResource TextBrush}"
                              Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="5">
                            <TextBlock Text="{res:LocalizationExtension Key=DefaultBinding_ReadOnlyProps}" 
                                      FontWeight="Bold"
                                      Foreground="{StaticResource SuccessBrush}"/>
                            <TextBlock Text="{res:LocalizationExtension Key=DefaultBinding_TextBlockText}" 
                                      Style="{StaticResource DescriptionStyle}"/>
                            <TextBlock Text="{res:LocalizationExtension Key=DefaultBinding_LabelContent}" 
                                      Style="{StaticResource DescriptionStyle}"/>
                            <TextBlock Text="{res:LocalizationExtension Key=DefaultBinding_OneWayMode}" 
                                      Style="{StaticResource DescriptionStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5">
                            <TextBlock Text="{res:LocalizationExtension Key=DefaultBinding_EditableProps}" 
                                      FontWeight="Bold"
                                      Foreground="{StaticResource WarningBrush}"/>
                            <TextBlock Text="{res:LocalizationExtension Key=DefaultBinding_TextBoxText}" 
                                      Style="{StaticResource DescriptionStyle}"/>
                            <TextBlock Text="{res:LocalizationExtension Key=DefaultBinding_CheckBoxIsChecked}" 
                                      Style="{StaticResource DescriptionStyle}"/>
                            <TextBlock Text="{res:LocalizationExtension Key=DefaultBinding_TwoWayMode}" 
                                      Style="{StaticResource DescriptionStyle}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>