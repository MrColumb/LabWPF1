<UserControl x:Class="WPF_MVVM_Demo.Views.DefaultBindingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="Transparent">

    <UserControl.Resources>
        <Style TargetType="Border" x:Key="DemoInnerBorder">
            <Setter Property="Background" Value="{StaticResource PanelLightBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" Opacity="0.3" ShadowDepth="3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock" x:Key="DescriptionStyle">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Opacity" Value="0.8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="SubHeaderStyle">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="SectionHeaderStyle">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  Background="Transparent">
        <StackPanel Margin="5">
            <TextBlock Text="{DynamicResource DefaultBindingTitle}" 
                       Style="{StaticResource SectionHeaderStyle}"
                       Foreground="{StaticResource AccentBrush}"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Прямая привязка к элементам интерфейса -->
                <Border Grid.Column="0" Style="{StaticResource DemoInnerBorder}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource DirectBindingToUI}" 
                                   Style="{StaticResource SubHeaderStyle}"
                                   Foreground="{StaticResource WarningBrush}"/>

                        <TextBlock Text="{DynamicResource TextBoxLabel}" 
                                   Foreground="{StaticResource TextBrush}" 
                                   Margin="0,5"/>
                        <TextBox x:Name="DirectTextBox" 
                                 Text="Введите текст" 
                                 Margin="0,0,0,10"
                                 Background="{StaticResource PanelBrush}"/>

                        <TextBlock Text="{DynamicResource TextFromTextBox}" 
                                   Foreground="{StaticResource TextBrush}" 
                                   Margin="0,5"/>
                        <TextBox Text="{Binding Text, ElementName=DirectTextBox}" 
                                 IsReadOnly="True" 
                                 Background="{StaticResource PanelBrush}"
                                 Opacity="0.8"
                                 Margin="0,0,0,10"/>

                        <TextBlock Text="{DynamicResource DirectBindingDescription}" 
                                   Style="{StaticResource DescriptionStyle}"/>
                    </StackPanel>
                </Border>

                <!-- Привязка через ViewModel -->
                <Border Grid.Column="1" Style="{StaticResource DemoInnerBorder}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource BindingViaViewModel}" 
                                   Style="{StaticResource SubHeaderStyle}"
                                   Foreground="{StaticResource SuccessBrush}"/>

                        <TextBlock Text="{DynamicResource FirstName}" Foreground="{StaticResource TextBrush}" Margin="0,5"/>
                        <TextBox Text="{Binding Person.FirstName}" 
                                 Margin="0,0,0,10"
                                 Background="{StaticResource PanelBrush}"/>

                        <TextBlock Text="{DynamicResource LastName}" Foreground="{StaticResource TextBrush}" Margin="0,5"/>
                        <TextBox Text="{Binding Person.LastName}" 
                                 Margin="0,0,0,10"
                                 Background="{StaticResource PanelBrush}"/>

                        <TextBlock Text="{DynamicResource Age}" Foreground="{StaticResource TextBrush}" Margin="0,5"/>
                        <TextBox Text="{Binding Person.Age}" 
                                 Margin="0,0,0,10"
                                 Background="{StaticResource PanelBrush}"/>

                        <TextBlock Text="{DynamicResource Email}" Foreground="{StaticResource TextBrush}" Margin="0,5"/>
                        <TextBox Text="{Binding Person.Email}" 
                                 Margin="0,0,0,10"
                                 Background="{StaticResource PanelBrush}"/>

                        <CheckBox Content="{DynamicResource Student}" 
                                  IsChecked="{Binding Person.IsStudent}" 
                                  Margin="0,5"
                                  Foreground="{StaticResource TextBrush}"/>

                        <Border Background="{StaticResource PanelBrush}" 
                                Padding="10" 
                                Margin="0,10"
                                CornerRadius="5">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource FullName}" 
                                          FontWeight="Bold"
                                          Foreground="{StaticResource SuccessBrush}"/>
                                <TextBlock Text="{Binding Person.FullName}" 
                                          FontSize="16"
                                          Foreground="{StaticResource AccentLightBrush}"/>
                                <TextBlock Text="{DynamicResource AutoUpdateDescription}" 
                                          Style="{StaticResource DescriptionStyle}"
                                          Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Цветная рамка для описания -->
            <Border Background="{StaticResource PanelBrush}" 
                    Padding="20" 
                    Margin="5,10"
                    CornerRadius="8"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="2">
                <StackPanel>
                    <TextBlock Text="📖 Описание привязки по умолчанию (Default)" 
                              FontSize="16" 
                              FontWeight="Bold"
                              Foreground="{StaticResource AccentBrush}"
                              Margin="0,0,0,10"/>
                    <TextBlock Text="{DynamicResource DefaultBindingDescription}" 
                              TextWrapping="Wrap" 
                              Foreground="{StaticResource TextBrush}"
                              Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="5">
                            <TextBlock Text="{DynamicResource ReadOnlyProperties}" 
                                      FontWeight="Bold"
                                      Foreground="{StaticResource SuccessBrush}"/>
                            <TextBlock Text="• TextBlock.Text" 
                                      Style="{StaticResource DescriptionStyle}"/>
                            <TextBlock Text="• Label.Content" 
                                      Style="{StaticResource DescriptionStyle}"/>
                            <TextBlock Text="{DynamicResource UsesOneWay}" 
                                      Style="{StaticResource DescriptionStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5">
                            <TextBlock Text="{DynamicResource EditableProperties}" 
                                      FontWeight="Bold"
                                      Foreground="{StaticResource WarningBrush}"/>
                            <TextBlock Text="• TextBox.Text" 
                                      Style="{StaticResource DescriptionStyle}"/>
                            <TextBlock Text="• CheckBox.IsChecked" 
                                      Style="{StaticResource DescriptionStyle}"/>
                            <TextBlock Text="{DynamicResource UsesTwoWay}" 
                                      Style="{StaticResource DescriptionStyle}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>