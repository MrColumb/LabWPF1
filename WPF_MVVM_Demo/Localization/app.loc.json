  "OneTime.Info.Title": { "en": "OneTime Binding Description", "ru": "Описание одноразовой привязки (OneTime)" },
  "OneTime.Info.Description": { "en": "OneTime binding sets a value once when binding is created and does not track further changes. It is useful for static data or when you need a snapshot at load time.", "ru": "Одноразовая привязка (OneTime) устанавливает значение один раз при создании привязки и не отслеживает последующие изменения. Это эффективно для статических данных или когда нужно показать 'снимок' данных на момент загрузки." },
  "OneTime.Info.Pros": { "en": "Advantages:", "ru": "Преимущества:" },
  "OneTime.Info.Pros1": { "en": "• Minimal overhead", "ru": "• Минимальная нагрузка" },
  "OneTime.Info.Pros2": { "en": "• Does not track changes", "ru": "• Не следит за изменениями" },
  "OneTime.Info.Pros3": { "en": "• Fast loading", "ru": "• Быстрая загрузка" },
  "OneTime.Info.Cons": { "en": "Drawbacks:", "ru": "Недостатки:" },
  "OneTime.Info.Cons1": { "en": "• Does not update", "ru": "• Не обновляется" },
  "OneTime.Info.Cons2": { "en": "• Initial value only", "ru": "• Только начальное значение" },
  "OneTime.Info.Cons3": { "en": "• Not suitable for dynamic data", "ru": "• Не подходит для динамики" },

